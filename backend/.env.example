# Native development template only; no credentials included.
# Export these variables in the launching shell. The backend does NOT auto-load .env.
# Compose uses docker/postgres/.env.example and maps WORDLE_DB_* to PG* separately.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=wordle
# Application role, never the initialization/superuser role.
PGUSER=wordle_app
# Set a NEW private application password outside Git before using a real local DB.
PGPASSWORD=
# Local isolated development only. Use an appropriate TLS policy for other environments.
PGSSLMODE=disable

# Exact browser origins, comma-separated; empty disables cross-origin access.
# Native launcher environment only; the backend does not auto-load this file.
WORDLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
